---
import Head from "../components/Head.astro";
import { site } from "../site.config";

interface Props { title?: string; description?: string; root: string; noindex?: boolean }
const { title, description = site.tagline, root, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
// адреса без .html: /q/slug, главная — /
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, "").replace(/(^|\/)index$/, "/"), site.url).href;
const ogImage = new URL("/og.png", site.url).href;
---
<html lang="ru">
  <head>
    <Head title={fullTitle} noindex={noindex}>
      <meta name="description" content={description} />
      <link rel="canonical" href={canonical} />
      <!-- превью ссылки в Telegram, VK и мессенджерах -->
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content={site.name} />
      <meta property="og:locale" content="ru_RU" />
      <meta property="og:title" content={title ?? site.name} />
      <meta property="og:description" content={description} />
      <meta property="og:url" content={canonical} />
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta name="twitter:card" content="summary_large_image" />
    </Head>
    <!-- Gilroy — заголовки (700) и чипы с кнопками (600) первого экрана: качаем сразу, а не после CSS, чтобы они раньше
         перешли с системного шрифта на Gilroy и не сдвигали страницу (CLS; чипы этапов в статье от смены шрифта
         перескакивали из двух строк в одну). Файлы есть только на сервере, локально и в превью preload даст 404 — не мешает. -->
    <link rel="preload" href="/fonts/gilroy/Gilroy-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/gilroy/Gilroy-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <!-- data-root: путь до корня сайта от текущей страницы, нужен поиску для ссылок на результаты -->
  <body data-root={root}>
    <header class="top">
      <div class="container top__row">
        <div class="top__brand">
          <a class="logo" href="/">Политех.<b>Ответы</b></a>
          <span class="top__note">{site.note}</span>
        </div>
        <nav class="top__nav" aria-label="Разделы">
          <!-- поиск с любой страницы: «Все вопросы» открываются с полем поиска в фокусе -->
          <a class="top__search" href="/questions#search" aria-label="Поиск по вопросам">
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
            <span class="top__search-text">Все вопросы</span>
          </a>
          <a class="btn btn--light" href="/about">О проекте</a>
        </nav>
      </div>
    </header>
    <main class="container page">
      <slot />
    </main>
    <footer class="foot">
      <div class="container foot__row">
        <p class="foot__mark">Политех.<br />Ответы</p>
        <p class="foot__note">Неофициальный сайт студентов. Ответы собраны из открытых студенческих чатов и сверены с сайтом университета там, где это указано. Они не заменяют официальные документы вуза.</p>
      </div>
    </footer>
  </body>
</html>
<style is:global>
  /* дублирует base.css: линтер Hallmark проверяет макет отдельно от стилей */
  html, body { overflow-x: clip; }
</style>
