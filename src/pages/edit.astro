---
// Редактор статей: вход по ссылке-приглашению, черновики, проверка и публикация. Всё рисует src/scripts/editor.js,
// данные — /api/ed/* (сервис на Rust, ../editor/, на rozb-server). Страница не индексируется и не попадает в поиск.
import Head from "../components/Head.astro";
import "../styles/editor.css";
import { site, stages, statuses, riskLabels } from "../site.config";

const stageTitles = stages.map((s) => [s.slug, s.title]);
const statusLabels = Object.fromEntries(Object.entries(statuses).map(([k, s]) => [k, s.label]));
---
<html lang="ru" data-theme="light">
  <head>
    <Head title={`Редактор — ${site.name}`} noindex lightOnly />
  </head>
  <body class="ed" data-stages={JSON.stringify(stageTitles)} data-risks={JSON.stringify(riskLabels)} data-statuses={JSON.stringify(statusLabels)}>
    <div id="app" class="ed-app"><p class="ed-empty">Загрузка…</p></div>
    <script src="../scripts/editor.js"></script>
  </body>
</html>
