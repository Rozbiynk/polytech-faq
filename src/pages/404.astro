---
import Base from "../layouts/Base.astro";
import Search from "../components/Search.astro";
---
<!-- 404 отдаётся с любого адреса, поэтому ссылки от корня сайта -->
<Base title="Страница не найдена" root="/">
  <section class="banner c-change">
    <h1>Такой страницы нет</h1>
    <p class="lead">Возможно, статья переехала. Поищите её своими словами или <a href="/index.html">вернитесь на главную</a>.</p>
  </section>
  <div class="searchbox">
    <Search />
  </div>
</Base>
