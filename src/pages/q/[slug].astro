---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Feedback from "../../components/Feedback.astro";
import { stageBySlug, statuses, riskLabels, redirects } from "../../site.config";

export async function getStaticPaths() {
  const pages = (await getCollection("articles")).map((a) => ({ params: { slug: a.id }, props: { a, to: undefined } }));
  // старые адреса из чатов ведут на новые статьи
  const moved = Object.entries(redirects).map(([from, to]) => ({ params: { slug: from }, props: { a: undefined, to } }));
  return [...pages, ...moved];
}
const { a, to } = Astro.props;
if (to) return new Response(
  `<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="robots" content="noindex">` +
  `<meta http-equiv="refresh" content="0; url=${to}.html"><link rel="canonical" href="${new URL(`/q/${to}.html`, Astro.site)}">` +
  `<title>Статья переехала</title></head><body><p>Статья переехала: <a href="${to}.html">открыть</a>.</p></body></html>`,
  { headers: { "Content-Type": "text/html; charset=utf-8" } });
const { Content } = await render(a!);
const d = a!.data;
const fmt = (x: Date) => x.toLocaleDateString("ru-RU", { day: "numeric", month: "long", year: "numeric" });
---
<Base title={d.title} root="../" description={`${d.title} Ответ для студентов и абитуриентов Московского Политеха.`}>
  <article class="article" data-pagefind-body>
    <header class="article__head">
      <div class="tags">
        {d.stages.map((s) => <a class={`chip c-${s}`} href={`/stage/${s}.html`} data-pagefind-ignore>{stageBySlug[s].title}</a>)}
        <span class={`pill ${d.status}`} data-pagefind-ignore>{statuses[d.status].label}</span>
        {d.actual && <span class="pill actual" data-pagefind-ignore>{d.actual}</span>}
      </div>
      <h1>{d.title}</h1>
      <p class={`notice ${d.status}`} data-pagefind-ignore>{statuses[d.status].note}</p>
    </header>

    <div class="article__body">
      <section class="block block--answer">
        <h2>Коротко</h2>
        <div class="answer" data-pagefind-meta="summary"><Content /></div>
      </section>

      <section class="block">
        <h2>Официальные источники</h2>
        {d.sources.length
          ? <ul class="sources">{d.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.title}</a></li>)}</ul>
          : <p class="empty">Ещё не добавлены. Знаете, где это написано на сайте вуза? Сообщите внизу страницы.</p>}
      </section>

      {d.tips.length > 0 && (
        <section class="block">
          <h2>Что говорят студенты</h2>
          <p class="empty">Личный опыт из чатов, как есть. Это не правила.</p>
          <ul class="tips">{d.tips.map((t) => <li>{t}</li>)}</ul>
        </section>
      )}
    </div>

    <dl class={`facts${d.risk === 3 ? " facts--risk" : ""}`} data-pagefind-ignore>
      <div><dt>{d.status === "sourced" ? "Сверено с сайтом вуза" : "Проверено"}</dt><dd>{d.checked ? fmt(d.checked) : "ещё нет"}</dd></div>
      <div class="facts__risk"><dt>Цена ошибки</dt><dd>{riskLabels[d.risk as 1 | 2 | 3]}</dd></div>
      {d.people && <div><dt>Спрашивали</dt><dd class="num">{d.people} человек в чатах</dd></div>}
    </dl>

    <!-- формулировки из чатов: не показываются, но по ним находит поиск («общага», «ЛК», опечатки) -->
    <div hidden>{d.aliases.join(" · ")}</div>
  </article>
  <Feedback slug={a!.id} />
</Base>
