---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Feedback from "../../components/Feedback.astro";
import QuestionList from "../../components/QuestionList.astro";
import { stageBySlug, statuses, riskLabels, redirects, topicBySlug } from "../../site.config";
import { getArticles, relatedTo, topicOf, isoDate, longDate, type Article } from "../../lib/articles";
import { movedPage } from "../../lib/moved";

type Props = { a: Article; related: Article[] } | { to: string };

export async function getStaticPaths() {
  const all = await getArticles();
  const pages = all.map((a) => ({ params: { slug: a.id }, props: { a, related: relatedTo(a, all) } }));
  // старые адреса из чатов ведут на новые статьи
  const moved = Object.entries(redirects).map(([from, to]) => ({ params: { slug: from }, props: { to } }));
  return [...pages, ...moved];
}
const props = Astro.props as Props;
if ("to" in props) return movedPage(props.to, Astro.site);

const { a, related } = props;
const { Content } = await render(a);
const d = a.data;
const topic = topicBySlug[topicOf(a)];
const checked = d.checked && { iso: isoDate(d.checked), text: longDate(d.checked) };
---
<Base title={d.title} root="../" description={`${d.title} Ответ для студентов и абитуриентов Московского Политеха.`}>
  {/* порядок в разметке — как читают на телефоне: заголовок, факты, ответ, отзыв, похожие;
      на широком экране факты и похожие встают в правую колонку (.article--answer в theme.css) */}
  <article class="article article--answer" data-pagefind-body>
    <header class="article__head">
      <a class="crumb" href={`/questions#${topic.slug}`} data-pagefind-ignore>← {topic.title}</a>
      <div class="tags">
        {d.stages.map((s) => <a class={`chip c-${s}`} href={`/stage/${s}`} data-pagefind-ignore>{stageBySlug[s].title}</a>)}
        <span class={`pill ${d.status}`} data-pagefind-ignore>{statuses[d.status].label}</span>
        {d.actual && <span class="pill actual" data-pagefind-ignore>{d.actual}</span>}
      </div>
      <h1>{d.title}</h1>
      {/* предупреждение о черновике — до ответа; про сверку с сайтом вуза — у источников */}
      {d.status === "draft" && <p class="notice draft" data-pagefind-ignore>{statuses.draft.note}</p>}
    </header>

    <dl class:list={["facts", d.risk === 3 && "facts--risk"]} data-pagefind-ignore>
      <div><dt>{checked ? statuses[d.status].checked : "Проверено"}</dt><dd>{checked ? <time datetime={checked.iso}>{checked.text}</time> : "ещё нет"}</dd></div>
      <div class="facts__risk"><dt>Если ошибиться</dt><dd>{riskLabels[d.risk as keyof typeof riskLabels]}</dd></div>
      {d.people && <div><dt>Спрашивали</dt><dd class="num">{d.people} человек в чатах</dd></div>}
    </dl>

    <div class="article__body">
      <section class="block block--answer">
        <h2>Коротко</h2>
        <div class="answer" data-pagefind-meta="summary"><Content /></div>
      </section>

      <section class="block">
        <h2>Официальные источники</h2>
        {d.status !== "draft" && <p class="block__note" data-pagefind-ignore>{statuses[d.status].note}</p>}
        {d.sources.length
          ? <ul class="sources">{d.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.title}<span class="visually-hidden"> (откроется в новой вкладке)</span></a></li>)}</ul>
          : <p class="empty">Ещё не добавлены. Знаете, где это написано на сайте вуза? Сообщите внизу страницы.</p>}
      </section>

      {d.tips.length > 0 && (
        <section class="block">
          <h2>Что говорят студенты</h2>
          <p class="empty">Личный опыт из чатов, как есть. Это не правила.</p>
          <ul class="tips">{d.tips.map((t) => <li>{t}</li>)}</ul>
        </section>
      )}
    </div>

    <Feedback slug={a.id} />
    {related.length > 0 && (
      <section class="related" aria-labelledby="related-h" data-pagefind-ignore>
        <h2 id="related-h">Похожие вопросы</h2>
        <QuestionList items={related} />
      </section>
    )}

    <!-- формулировки из чатов: не показываются, но по ним находит поиск («общага», «ЛК», опечатки) -->
    <div hidden>{d.aliases.join(" · ")}</div>
  </article>
</Base>
