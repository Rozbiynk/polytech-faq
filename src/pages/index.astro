---
import Base from "../layouts/Base.astro";
import Search from "../components/Search.astro";
import QuestionList from "../components/QuestionList.astro";
import { site, stages, topics } from "../site.config";
import { getArticles, topicOf } from "../lib/articles";

const all = await getArticles();
const popular = site.popular.flatMap((id) => all.find((a) => a.id === id) ?? []);
// этапы и темы без статей не показываем (страница пустого этапа остаётся)
const liveStages = stages.filter((s) => all.some((a) => a.data.stages.includes(s.slug)));
const liveTopics = topics.map((t) => ({ ...t, n: all.filter((a) => topicOf(a) === t.slug).length })).filter((t) => t.n > 0);
---
<Base root="./">
  <section class="hero band">
    <div class="hero__text">
      <p class="eyebrow">{site.slogan}</p>
      <h1>Ответы на вопросы, которые в чатах задают каждый год</h1>
      <p class="lead">{site.tagline}. Ищите своими словами:</p>
      <div class="hints" aria-label="Примеры запросов">
        {site.hints.map((h) => <button type="button" class="hint" data-q={h}>{h}</button>)}
      </div>
      <div class="searchbox">
        <Search />
      </div>
      <div class="popular">
        <span class="popular__label">Часто ищут</span>
        <ul>{popular.map((a) => <li><a href={`/q/${a.id}`}>{a.data.title} <span aria-hidden="true">→</span></a></li>)}</ul>
      </div>
    </div>

    <section class="stages-wrap" aria-labelledby="stages-h">
      <h2 id="stages-h">На каком вы этапе?</h2>
      <div class="stages">
        {liveStages.map((s) => (
          <a class={`stage c-${s.slug}`} href={`/stage/${s.slug}`}>
            <strong>{s.title}</strong>
            <span>{s.desc}</span>
            <span class="stage__go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
  </section>

  <section class="section split" aria-labelledby="top-h">
    <h2 id="top-h">Чаще всего спрашивают</h2>
    <div class="split__body top-list">
      <!-- темы: показывают 10 самых частых вопросов темы (src/scripts/top-topics.js); без JS — общий топ-10 -->
      <div class="tabs" role="group" aria-label="Тема">
        <button type="button" class="tab" data-topic="" aria-pressed="true">Все темы</button>
        {liveTopics.map((t) => <button type="button" class="tab" data-topic={t.slug} aria-pressed="false">{t.title}</button>)}
      </div>
      <QuestionList items={all} limit={10} />
      <a class="btn more" href="/questions">Все вопросы ({all.length}) →</a>
    </div>
  </section>

  <section class="section split" aria-labelledby="topics-h">
    <h2 id="topics-h">Вопросы по темам</h2>
    <ul class="topics">
      {liveTopics.map((t) => (
        <li><a href={`/questions#${t.slug}`}>
          <strong>{t.title}</strong>
          <span>{t.desc}</span>
          <span class="topics__n num">{t.n}</span>
        </a></li>
      ))}
    </ul>
  </section>
  <script src="../scripts/top-topics.js"></script>
</Base>
