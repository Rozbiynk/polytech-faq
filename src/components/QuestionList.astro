---
import type { CollectionEntry } from "astro:content";
import { statuses, topicOf } from "../site.config";

// limit: сколько строк видно сразу; остальные скрыты (их показывает фильтр по темам на главной)
interface Props { items: CollectionEntry<"articles">[]; limit?: number }
const { items, limit = Infinity } = Astro.props;
---
<ul class="qlist">
  {items.map((a, i) => (
    <li data-stages={a.data.stages.join(" ")} data-topic={topicOf(a.id, a.data.stages)} hidden={i >= limit}>
      <a href={`/q/${a.id}`}>
        <span class="q">{a.data.title}</span>
        <span class="qlist__go" aria-hidden="true">→</span>
        <span class="badges">
          <span class={`pill ${a.data.status}`}>{a.data.status !== "draft" && <span aria-hidden="true">✓ </span>}{statuses[a.data.status].label}</span>
          {a.data.risk === 3 && <span class="pill risk">важно не ошибиться</span>}
        </span>
        {a.data.people && <span class="count num">спрашивали {a.data.people} чел.</span>}
      </a>
    </li>
  ))}
</ul>
